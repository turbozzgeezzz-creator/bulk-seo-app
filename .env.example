# Copy to .env for local development. Never commit .env.
# `shopify app dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES
# itself from the linked Partner app; set them yourself only when running outside the CLI
# (e.g. in production, via your host's secrets storage).
SHOPIFY_API_KEY=112d8cc57cd35b3baa6d4718b23c7f02
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,write_files

# Required for generation. Use a key from an Anthropic Console account billed to BulkFlow.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5.
# AI_MODEL=

# Billing stays off until all three are set (docs/OPEN_DECISIONS.md).
# BILLING_PLAN_NAME=
# BILLING_PLAN_AMOUNT=
# BILLING_PLAN_CURRENCY=
# BILLING_TRIAL_DAYS=
# BILLING_TEST=true
